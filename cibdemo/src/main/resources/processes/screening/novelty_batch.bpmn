<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_NoveltyBatch" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.35.0">
  <bpmn:process id="novelty_batch" name="Novelty Batch Screening" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Batch-screen submitted abstracts against the historical corpus via the novelty pipeline: ingest -> screen (chunked) -> optionally ask the larger model (35B) whether each unflagged abstract adds anything new -> build results.json + flagged report -> notify the committee. Triage evidence for human reviewers, never an accept/reject.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_Start" name="Batch triggered">
      <bpmn:outgoing>Flow_Start_Ingest</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="st_ingest" name="Ingest submissions" camunda:type="external" camunda:topic="novelty_ingest">
      <bpmn:incoming>Flow_Start_Ingest</bpmn:incoming>
      <bpmn:outgoing>Flow_Ingest_Screen</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="st_screen" name="Screen via pipeline (chunked)" camunda:type="external" camunda:topic="novelty_screen">
      <bpmn:incoming>Flow_Ingest_Screen</bpmn:incoming>
      <bpmn:outgoing>Flow_Screen_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_AskNew" name="Ask the larger model?" default="Flow_Ask_No">
      <bpmn:incoming>Flow_Screen_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Ask_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Ask_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="st_ask_new" name="Ask 35B: adds anything new? (chunked)" camunda:type="external" camunda:topic="novelty_ask_new">
      <bpmn:documentation>Only the abstracts screening let through; about 40 s each. "Nothing new" and "only partly new" count as flagged.</bpmn:documentation>
      <bpmn:incoming>Flow_Ask_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Ask_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_AskJoin">
      <bpmn:incoming>Flow_Ask_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Ask_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Report</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="st_report" name="Build results + flagged report" camunda:type="external" camunda:topic="novelty_report">
      <bpmn:incoming>Flow_Join_Report</bpmn:incoming>
      <bpmn:outgoing>Flow_Report_Notify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="st_notify" name="Notify committee" camunda:type="external" camunda:topic="novelty_notify">
      <bpmn:incoming>Flow_Report_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Done" name="Report ready">
      <bpmn:incoming>Flow_Notify_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Ingest" sourceRef="StartEvent_Start" targetRef="st_ingest" />
    <bpmn:sequenceFlow id="Flow_Ingest_Screen" sourceRef="st_ingest" targetRef="st_screen" />
    <bpmn:sequenceFlow id="Flow_Screen_Gateway" sourceRef="st_screen" targetRef="Gateway_AskNew" />
    <bpmn:sequenceFlow id="Flow_Ask_Yes" name="askNew" sourceRef="Gateway_AskNew" targetRef="st_ask_new">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable('askNew') == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Ask_No" name="no" sourceRef="Gateway_AskNew" targetRef="Gateway_AskJoin" />
    <bpmn:sequenceFlow id="Flow_Ask_Join" sourceRef="st_ask_new" targetRef="Gateway_AskJoin" />
    <bpmn:sequenceFlow id="Flow_Join_Report" sourceRef="Gateway_AskJoin" targetRef="st_report" />
    <bpmn:sequenceFlow id="Flow_Report_Notify" sourceRef="st_report" targetRef="st_notify" />
    <bpmn:sequenceFlow id="Flow_Notify_End" sourceRef="st_notify" targetRef="EndEvent_Done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="novelty_batch">
      <bpmndi:BPMNShape id="StartEvent_Start_di" bpmnElement="StartEvent_Start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="146" y="143" width="65" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_ingest_di" bpmnElement="st_ingest">
        <dc:Bounds x="250" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_screen_di" bpmnElement="st_screen">
        <dc:Bounds x="410" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AskNew_di" bpmnElement="Gateway_AskNew" isMarkerVisible="true">
        <dc:Bounds x="560" y="93" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="532" y="56" width="106" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_ask_new_di" bpmnElement="st_ask_new">
        <dc:Bounds x="645" y="190" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AskJoin_di" bpmnElement="Gateway_AskJoin" isMarkerVisible="true">
        <dc:Bounds x="800" y="93" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_report_di" bpmnElement="st_report">
        <dc:Bounds x="890" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_notify_di" bpmnElement="st_notify">
        <dc:Bounds x="1050" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Done_di" bpmnElement="EndEvent_Done">
        <dc:Bounds x="1212" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1198" y="143" width="65" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Ingest_di" bpmnElement="Flow_Start_Ingest">
        <di:waypoint x="196" y="118" /><di:waypoint x="250" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ingest_Screen_di" bpmnElement="Flow_Ingest_Screen">
        <di:waypoint x="350" y="118" /><di:waypoint x="410" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Screen_Gateway_di" bpmnElement="Flow_Screen_Gateway">
        <di:waypoint x="510" y="118" /><di:waypoint x="560" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ask_Yes_di" bpmnElement="Flow_Ask_Yes">
        <di:waypoint x="585" y="143" /><di:waypoint x="585" y="230" /><di:waypoint x="645" y="230" />
        <bpmndi:BPMNLabel><dc:Bounds x="592" y="183" width="40" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ask_No_di" bpmnElement="Flow_Ask_No">
        <di:waypoint x="610" y="118" /><di:waypoint x="800" y="118" />
        <bpmndi:BPMNLabel><dc:Bounds x="698" y="100" width="14" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ask_Join_di" bpmnElement="Flow_Ask_Join">
        <di:waypoint x="765" y="230" /><di:waypoint x="825" y="230" /><di:waypoint x="825" y="143" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join_Report_di" bpmnElement="Flow_Join_Report">
        <di:waypoint x="850" y="118" /><di:waypoint x="890" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Report_Notify_di" bpmnElement="Flow_Report_Notify">
        <di:waypoint x="990" y="118" /><di:waypoint x="1050" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Notify_End_di" bpmnElement="Flow_Notify_End">
        <di:waypoint x="1150" y="118" /><di:waypoint x="1212" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
