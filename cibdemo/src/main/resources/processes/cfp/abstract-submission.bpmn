<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AbstractLifecycle" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.35.0">
  <bpmn:process id="abstract_submission_lifecycle" name="Abstract Submission Lifecycle" isExecutable="true" camunda:historyTimeToLive="12345">
    <bpmn:documentation>Complete lifecycle of scientific conference abstract submissions — from call for papers through final presentation. Covers free paper and invited speaker pathways, peer review, format assignment, author confirmation, registration gate, and presentation — with all exit paths (way-outs). Replace [n] placeholders with current counts for pipeline visibility.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_FreePaper" name="Call for Free Papers Opens">
      <bpmn:categoryValueRef>CatVal_Group_Stage1</bpmn:categoryValueRef>
      <bpmn:outgoing>Flow_Start_FP</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_SubmissionValid" name="Submission Valid?" gatewayDirection="Diverging">
      <bpmn:categoryValueRef>CatVal_Group_Stage1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Receive_to_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_InvitationAccepted" name="Invitation Accepted?" gatewayDirection="Diverging">
      <bpmn:categoryValueRef>CatVal_Group_Stage1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Process_to_GW</bpmn:incoming>
      <bpmn:outgoing>Flow_Inv_Accepted</bpmn:outgoing>
      <bpmn:outgoing>Flow_Inv_Declined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_AcceptReject" name="Accept or Reject?" gatewayDirection="Diverging">
      <bpmn:categoryValueRef>CatVal_Group_Stage3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Score_to_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Accept</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_MergeAccepted" name="" gatewayDirection="Converging">
      <bpmn:categoryValueRef>CatVal_Group_Stage3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Accept</bpmn:incoming>
      <bpmn:incoming>Flow_Invited_to_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_to_Format</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_AuthorConfirms" name="Author Confirms Participation?" gatewayDirection="Diverging">
      <bpmn:categoryValueRef>CatVal_Group_Stage4</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_1whghm6</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirms</bpmn:outgoing>
      <bpmn:outgoing>Flow_Declines</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_ResponseAfterReminder" name="Response After Reminder?" gatewayDirection="Diverging">
      <bpmn:categoryValueRef>CatVal_Group_Stage4</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_1dkc0hz</bpmn:incoming>
      <bpmn:outgoing>Flow_Response_Confirms</bpmn:outgoing>
      <bpmn:outgoing>Flow_Response_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_MergeConfirmed" name="" gatewayDirection="Converging">
      <bpmn:categoryValueRef>CatVal_Group_Stage4</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Confirms</bpmn:incoming>
      <bpmn:incoming>Flow_Response_Confirms</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirmed_to_Reg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_RegisteredByDeadline" name="Author Registered by Deadline?" gatewayDirection="Diverging">
      <bpmn:categoryValueRef>CatVal_Group_Stage5</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_1q2mxua</bpmn:incoming>
      <bpmn:outgoing>Flow_Registered_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Registered_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_RegAfterReminder" name="Registered After Reminder?" gatewayDirection="Diverging">
      <bpmn:categoryValueRef>CatVal_Group_Stage5</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_0b1z83a</bpmn:incoming>
      <bpmn:outgoing>Flow_RegAfter_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_RegAfter_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_MergeRegistered" name="" gatewayDirection="Converging">
      <bpmn:categoryValueRef>CatVal_Group_Stage5</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Registered_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_RegAfter_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Reg_to_Upload</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_PresenterArrives" name="Presenter Shows Up?" gatewayDirection="Diverging">
      <bpmn:categoryValueRef>CatVal_Group_Stage6</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_1320jye</bpmn:incoming>
      <bpmn:outgoing>Flow_Arrives_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Arrives_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Presented" name="Successfully Presented">
      <bpmn:categoryValueRef>CatVal_Group_Stage6</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Present_to_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_InvalidSubmission" name="Submission Invalid">
      <bpmn:categoryValueRef>CatVal_Group_Stage1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Valid_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_InvitationDeclined" name="Invitation Declined">
      <bpmn:categoryValueRef>CatVal_Group_Stage1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Inv_Declined</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Rejected" name="Abstract Rejected">
      <bpmn:categoryValueRef>CatVal_Group_Stage3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Rejection_to_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_AuthorDeclined" name="Author Declined to Present">
      <bpmn:categoryValueRef>CatVal_Group_Stage4</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Declines</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_NoResponse" name="Author Unresponsive — Removed">
      <bpmn:categoryValueRef>CatVal_Group_Stage4</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Response_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_NotRegistered" name="Not Registered — Removed">
      <bpmn:categoryValueRef>CatVal_Group_Stage5</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_RegAfter_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_NoShow" name="No-Show Recorded">
      <bpmn:categoryValueRef>CatVal_Group_Stage6</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_NoShow_to_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_FP" sourceRef="StartEvent_FreePaper" targetRef="Gateway_1kg5klm">
      <bpmn:categoryValueRef>CatVal_Group_Stage1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Receive_to_Valid" sourceRef="ut_receive_submission" targetRef="Gateway_SubmissionValid">
      <bpmn:categoryValueRef>CatVal_Group_Stage1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Valid_Yes" name="Valid" sourceRef="Gateway_SubmissionValid" targetRef="ca_novelty_check">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${submission_valid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Novelty_to_Assign" sourceRef="ca_novelty_check" targetRef="ut_assign_reviewers" />
    <bpmn:sequenceFlow id="Flow_Valid_No" name="Invalid" sourceRef="Gateway_SubmissionValid" targetRef="EndEvent_InvalidSubmission">
      <bpmn:categoryValueRef>CatVal_Group_Stage1</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!submission_valid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Assign_to_Score" sourceRef="ut_assign_reviewers" targetRef="ut_score_abstract">
      <bpmn:categoryValueRef>CatVal_Group_Stage2</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Score_to_Decision" sourceRef="ut_score_abstract" targetRef="Gateway_AcceptReject" />
    <bpmn:sequenceFlow id="Flow_Accept" name="Accept" sourceRef="Gateway_AcceptReject" targetRef="Gateway_MergeAccepted">
      <bpmn:categoryValueRef>CatVal_Group_Stage3</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${abstract_accepted}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reject" name="Reject" sourceRef="Gateway_AcceptReject" targetRef="SendTask_NotifyRejection">
      <bpmn:categoryValueRef>CatVal_Group_Stage3</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!abstract_accepted}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejection_to_End" sourceRef="SendTask_NotifyRejection" targetRef="EndEvent_Rejected">
      <bpmn:categoryValueRef>CatVal_Group_Stage3</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Process_to_GW" sourceRef="ut_process_invitation" targetRef="Gateway_InvitationAccepted">
      <bpmn:categoryValueRef>CatVal_Group_Stage1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Inv_Accepted" name="Accepted" sourceRef="Gateway_InvitationAccepted" targetRef="ut_receive_invited_abstract">
      <bpmn:categoryValueRef>CatVal_Group_Stage1</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${invitation_accepted}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Inv_Declined" name="Declined" sourceRef="Gateway_InvitationAccepted" targetRef="EndEvent_InvitationDeclined">
      <bpmn:categoryValueRef>CatVal_Group_Stage1</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!invitation_accepted}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Invited_to_Merge" sourceRef="ut_receive_invited_abstract" targetRef="Gateway_MergeAccepted" />
    <bpmn:sequenceFlow id="Flow_Merge_to_Format" sourceRef="Gateway_MergeAccepted" targetRef="ut_assign_format">
      <bpmn:categoryValueRef>CatVal_Group_Stage3</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Format_to_Notify" sourceRef="ut_assign_format" targetRef="SendTask_NotifyAcceptance" />
    <bpmn:sequenceFlow id="Flow_Notify_to_Confirm" sourceRef="SendTask_NotifyAcceptance" targetRef="ut_mock_confirmation">
      <bpmn:categoryValueRef>CatVal_Group_Stage4</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Confirms" name="Confirms" sourceRef="Gateway_AuthorConfirms" targetRef="Gateway_MergeConfirmed">
      <bpmn:categoryValueRef>CatVal_Group_Stage4</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${author_confirmed == "yes"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Declines" name="Declines" sourceRef="Gateway_AuthorConfirms" targetRef="EndEvent_AuthorDeclined">
      <bpmn:categoryValueRef>CatVal_Group_Stage4</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${author_confirmed == "declined"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoResponse" name="No Response" sourceRef="Gateway_AuthorConfirms" targetRef="SendTask_SendConfirmReminder">
      <bpmn:categoryValueRef>CatVal_Group_Stage4</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${author_confirmed == "pending"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reminder_to_GW" sourceRef="SendTask_SendConfirmReminder" targetRef="st_mock_no_response">
      <bpmn:categoryValueRef>CatVal_Group_Stage4</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Response_Confirms" name="Confirms" sourceRef="Gateway_ResponseAfterReminder" targetRef="Gateway_MergeConfirmed">
      <bpmn:categoryValueRef>CatVal_Group_Stage4</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${author_confirmed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Response_No" name="No Response" sourceRef="Gateway_ResponseAfterReminder" targetRef="EndEvent_NoResponse">
      <bpmn:categoryValueRef>CatVal_Group_Stage4</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!author_confirmed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Confirmed_to_Reg" sourceRef="Gateway_MergeConfirmed" targetRef="ut_mock_registration" />
    <bpmn:sequenceFlow id="Flow_Registered_Yes" name="Registered" sourceRef="Gateway_RegisteredByDeadline" targetRef="Gateway_MergeRegistered">
      <bpmn:categoryValueRef>CatVal_Group_Stage5</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${author_registered}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Registered_No" name="Not Registered" sourceRef="Gateway_RegisteredByDeadline" targetRef="SendTask_SendRegReminder">
      <bpmn:categoryValueRef>CatVal_Group_Stage5</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!author_registered}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RegReminder_to_GW" sourceRef="SendTask_SendRegReminder" targetRef="mock_registered">
      <bpmn:categoryValueRef>CatVal_Group_Stage5</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RegAfter_Yes" name="Registered" sourceRef="Gateway_RegAfterReminder" targetRef="Gateway_MergeRegistered">
      <bpmn:categoryValueRef>CatVal_Group_Stage5</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${author_registered}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RegAfter_No" name="Not Registered" sourceRef="Gateway_RegAfterReminder" targetRef="EndEvent_NotRegistered">
      <bpmn:categoryValueRef>CatVal_Group_Stage5</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!author_registered}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reg_to_Upload" sourceRef="Gateway_MergeRegistered" targetRef="ut_upload-materials" />
    <bpmn:sequenceFlow id="Flow_Upload_to_Ready" sourceRef="ut_upload-materials" targetRef="ut_speaker_ready_room">
      <bpmn:categoryValueRef>CatVal_Group_Stage6</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Ready_to_Arrival" sourceRef="ut_speaker_ready_room" targetRef="ut_mock_presenter">
      <bpmn:categoryValueRef>CatVal_Group_Stage6</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Arrives_Yes" name="Shows Up" sourceRef="Gateway_PresenterArrives" targetRef="ut_deliver_presentation">
      <bpmn:categoryValueRef>CatVal_Group_Stage6</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${presenter_shows_up}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Arrives_No" name="No-Show" sourceRef="Gateway_PresenterArrives" targetRef="ut_record_no_show">
      <bpmn:categoryValueRef>CatVal_Group_Stage6</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!presenter_shows_up}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Present_to_End" sourceRef="ut_deliver_presentation" targetRef="EndEvent_Presented">
      <bpmn:categoryValueRef>CatVal_Group_Stage6</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoShow_to_End" sourceRef="ut_record_no_show" targetRef="EndEvent_NoShow">
      <bpmn:categoryValueRef>CatVal_Group_Stage6</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sendTask id="SendTask_NotifyAcceptance" name="Notify Author of Acceptance &#38; Format" camunda:type="external" camunda:topic="notify_author_acceptance">
      <bpmn:categoryValueRef>CatVal_Group_Stage4</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Format_to_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_to_Confirm</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="ut_receive_submission" name="Receive &#38; Validate Abstract Submission">
      <bpmn:categoryValueRef>CatVal_Group_Stage1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_1uupmbk</bpmn:incoming>
      <bpmn:outgoing>Flow_Receive_to_Valid</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ut_process_invitation" name="Process Speaker Invitation">
      <bpmn:categoryValueRef>CatVal_Group_Stage1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_0nnw8gb</bpmn:incoming>
      <bpmn:outgoing>Flow_Process_to_GW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ut_receive_invited_abstract" name="Receive Invited Speaker Abstract">
      <bpmn:categoryValueRef>CatVal_Group_Stage1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Inv_Accepted</bpmn:incoming>
      <bpmn:outgoing>Flow_Invited_to_Merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="ca_novelty_check" name="Novelty Check" calledElement="novelty_check" camunda:calledElementTenantId="cfp">
      <bpmn:documentation>Calls the novelty_check process (novelty-check.bpmn): screening against PubMed, then — if that finds nothing — the larger model's "adds anything new?". The result is stored per submission and shown at Assign Reviewers. If the pipeline stays unreachable the check is recorded as unavailable and the process goes on.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in source="submissionId" target="submissionId" />
        <camunda:out source="novelty_status" target="novelty_status" />
        <camunda:out source="novelty_verdict" target="novelty_verdict" />
        <camunda:out source="novelty_adds_new" target="novelty_adds_new" />
        <camunda:out source="novelty_flagged" target="novelty_flagged" />
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CatVal_Group_Stage1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Valid_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Novelty_to_Assign</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="ut_assign_reviewers" name="Assign Reviewers (3–4 per Abstract)">
      <bpmn:categoryValueRef>CatVal_Group_Stage2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Novelty_to_Assign</bpmn:incoming>
      <bpmn:outgoing>Flow_Assign_to_Score</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ut_score_abstract" name="Score Abstracts (Blind Review)">
      <bpmn:categoryValueRef>CatVal_Group_Stage2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Assign_to_Score</bpmn:incoming>
      <bpmn:outgoing>Flow_Score_to_Decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="SendTask_NotifyRejection" name="Notify Author of Rejection" camunda:type="external" camunda:topic="notify_author_rejection">
      <bpmn:categoryValueRef>CatVal_Group_Stage3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_Rejection_to_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="ut_assign_format" name="Assign Presentation Format">
      <bpmn:categoryValueRef>CatVal_Group_Stage3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Merge_to_Format</bpmn:incoming>
      <bpmn:outgoing>Flow_Format_to_Notify</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="SendTask_SendConfirmReminder" name="Send Confirmation Reminder" camunda:type="external" camunda:topic="send_confirmation_reminder">
      <bpmn:categoryValueRef>CatVal_Group_Stage4</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_NoResponse</bpmn:incoming>
      <bpmn:outgoing>Flow_Reminder_to_GW</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="SendTask_SendRegReminder" name="Send Registration Reminder" camunda:type="external" camunda:topic="send_registration_reminder">
      <bpmn:categoryValueRef>CatVal_Group_Stage5</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Registered_No</bpmn:incoming>
      <bpmn:outgoing>Flow_RegReminder_to_GW</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="ut_upload-materials" name="Upload Presentation Materials">
      <bpmn:categoryValueRef>CatVal_Group_Stage6</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Reg_to_Upload</bpmn:incoming>
      <bpmn:outgoing>Flow_Upload_to_Ready</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ut_speaker_ready_room" name="Speaker Ready Room Check">
      <bpmn:categoryValueRef>CatVal_Group_Stage6</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Upload_to_Ready</bpmn:incoming>
      <bpmn:outgoing>Flow_Ready_to_Arrival</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ut_deliver_presentation" name="Deliver Presentation">
      <bpmn:categoryValueRef>CatVal_Group_Stage6</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Arrives_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Present_to_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ut_record_no_show" name="Record No-Show &#38; Apply Sanctions">
